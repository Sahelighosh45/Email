PORT=3000
FRONTEND_URL=http://localhost:3000

# Database (optional - falls back to in-memory store when unset)
DATABASE_URL=

# Redis (optional - falls back to in-memory queue & rate limiter when unset)
REDIS_URL=

# Auth
JWT_SECRET=reachinbox-dev-secret-key
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Frontend API base URL (leave empty for same-origin in unified server)
VITE_API_URL=

# Email Delivery (optional - simulates delivery in-memory when unset)
RESEND_API_KEY=
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Worker / Rate Limiting
START_WORKER=true
MAX_EMAILS_PER_HOUR=30
MIN_DELAY_BETWEEN_EMAILS_MS=2000
WORKER_CONCURRENCY=3
